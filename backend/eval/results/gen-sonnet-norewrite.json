    {
      "id": "q18",
      "question": "酒測時拒絕配合會被怎麼處理？",
      "category": "cross_law",
      "should_refuse": false,
      "expected": [
        "K0040012:35",
        "D0080029:19-2"
      ],
      "queries": [
