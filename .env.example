# 複製成 .env 後填入；.env 不進版控
ANTHROPIC_API_KEY=
# Embedding（Voyage AI）；建索引與線上檢索都需要
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
# 值為 JSON 陣列
CORS_ORIGINS=["http://localhost:5173"]
# LLM（預設 claude-sonnet-5-5；品質不足再換 claude-opus-5-5）
LLM_MODEL=claude-sonnet-5-5
GATE_THRESHOLD=0.40
REWRITE_ENABLED=false
# /api/ask 速率限制（每個 IP 在視窗內最多幾次）
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# 全站每天（UTC）最多幾次提問，保護自己的 API 額度
DAILY_ASK_LIMIT=300
TRUST_PROXY=false
# 部署用：後端一併提供前端建置檔的目錄（本機開發不要設；映像內已設為 /app/static）
# STATIC_DIR=
# 前端 GitHub 連結（建置時讀取，不設就用預設的公開 repo）
# VITE_GITHUB_URL=https://github.com/leannechen/traffic-law-rag
